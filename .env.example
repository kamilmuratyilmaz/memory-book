# Copy to .env and fill in. `uv run memory-book` and `docker compose` both read .env; real environment variables win.
# .env is git- and docker-ignored: it is never committed or copied into an image.

# Any LiteLLM model (https://docs.litellm.ai/docs/providers). Without its key the app runs the offline designer.
MEMORY_BOOK_MODEL=gemini/gemini-3.8-flash
GEMINI_API_KEY=
# MEMORY_BOOK_FALLBACK_MODELS=anthropic/claude-opus-5-5,openai/gpt-5   # tried in order if the main model fails
# MEMORY_BOOK_EFFORT=medium                                            # reasoning effort, where the model supports it
# MEMORY_BOOK_THINKING_BUDGET=1024                                     # thinking tokens (Gemini default 1024; 0 = off)

# Keys for other providers, only if you use them:
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=wrkspc_...   # only for Anthropic keys not scoped to a workspace
# OPENAI_API_KEY=
# OLLAMA_API_BASE=http://host.docker.internal:11434   # local models need no key

# Change before exposing the stack beyond localhost.
# POSTGRES_PASSWORD=memory_book
# S3_ACCESS_KEY=rustfsadmin
# S3_SECRET_KEY=rustfsadmin

# MLFLOW_TRACE_CONTENT=true
